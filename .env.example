# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=ragdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=support_kb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally; swap for AWS S3 / R2 / B2 later) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=support-kb
S3_REGION=us-east-1

# --- Models (all local/free) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Auth (used from Step 11) ---
# dev | production. In production the API refuses to start with a weak JWT_SECRET.
APP_ENV=dev
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-real-use
JWT_EXPIRE_MINUTES=60

# --- Airflow (Step 8b, optional; defaults are fine for local dev) ---
# AIRFLOW_JWT_SECRET=
# AIRFLOW_API_SECRET_KEY=

# --- Monitoring (Step 13, optional) ---
# If set, GET /metrics requires "Authorization: Bearer <this>". Put the same value in
# infra/prometheus/prometheus.yml (authorization block). Leave empty on localhost.
METRICS_TOKEN=

# Admin page: where the browser reaches Grafana (embedded in /admin). Empty = hide the dashboard.
GRAFANA_URL=http://localhost:3000
